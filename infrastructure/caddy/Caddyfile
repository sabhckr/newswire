# HTTPS reverse proxy. Caddy obtains and renews a free Let's Encrypt certificate for
# NEWSWIRE_DOMAIN automatically. API and media go straight to FastAPI; everything else to Next.js.
{$NEWSWIRE_DOMAIN} {
	encode zstd gzip

	@backend path /api/* /media/*
	handle @backend {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	request_body {
		max_size 20MB
	}
}
