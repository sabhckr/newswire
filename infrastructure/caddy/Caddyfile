# HTTPS reverse proxy. Caddy obtains and renews a free Let's Encrypt certificate for
# NEWSWIRE_DOMAIN automatically. API and media go straight to FastAPI; everything else to Next.js.
{$NEWSWIRE_DOMAIN} {
	encode zstd gzip

	@backend path /api/* /media/*
	handle @backend {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Requests are limited to 20 MB. Browsers upload videos in 8 MB pieces (/api/v1/videos/uploads/...).
	# Only scripts that POST a whole file to /api/v1/videos need more: up to NEWSWIRE_MAX_VIDEO_BYTES.
	@videos path /api/v1/videos
	@not_videos not path /api/v1/videos
	request_body @videos {
		max_size 1100MB
	}
	request_body @not_videos {
		max_size 20MB
	}
}
