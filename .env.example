# NEWSWIRE configuration. Copy to .env and edit. Every variable is optional except where noted.
# Secrets live only here (or in your secret manager); never in the frontend.

# --- Required in production -----------------------------------------------------------------
NEWSWIRE_ENV=production
# 64+ random characters. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it later makes stored publishing credentials unreadable (re-enter them).
NEWSWIRE_SECRET_KEY=
# Docker Compose only: password for the bundled PostgreSQL service.
POSTGRES_PASSWORD=

# --- Database and storage --------------------------------------------------------------------
# Set automatically by docker-compose.yml. For bare-metal installs:
# NEWSWIRE_DATABASE_URL=postgresql+psycopg://newswire:PASSWORD@localhost:5432/newswire
# NEWSWIRE_STORAGE_DIR=/var/lib/newswire

# --- Web -------------------------------------------------------------------------------------
# The address readers and editors use. Used for links in the built-in public API and RSS feed.
NEWSWIRE_PUBLIC_BASE_URL=http://localhost:3000
# Set true when served over HTTPS (sends cookies with the Secure flag and HSTS).
NEWSWIRE_COOKIE_SECURE=false
# Docker Compose: host port for the web UI, and the domain for the optional Caddy HTTPS proxy.
NEWSWIRE_HTTP_PORT=3000
# NEWSWIRE_DOMAIN=news.example.org

# --- Sessions -------------------------------------------------------------------------------
NEWSWIRE_SESSION_IDLE_MINUTES=720
NEWSWIRE_SESSION_ABSOLUTE_HOURS=336

# --- Collection ------------------------------------------------------------------------------
NEWSWIRE_FETCH_CONCURRENCY=4
NEWSWIRE_FETCH_TIMEOUT_SECONDS=20
NEWSWIRE_PER_HOST_DELAY_SECONDS=1
NEWSWIRE_MIN_POLL_INTERVAL_SECONDS=60
NEWSWIRE_DEFAULT_POLL_INTERVAL_SECONDS=300
NEWSWIRE_MAX_BACKOFF_SECONDS=21600
NEWSWIRE_MAX_FEED_BYTES=5000000
# Identify your installation politely. A contact (URL or mailbox) is appended to the User-Agent;
# Wikimedia asks API clients to provide one.
NEWSWIRE_USER_AGENT=NEWSWIRE/0.10 (self-hosted news monitor)
NEWSWIRE_CONTACT=
# Only for development against feeds on your own network. Leave false in production (SSRF guard).
NEWSWIRE_ALLOW_PRIVATE_NETWORK=false

# --- Scheduler -------------------------------------------------------------------------------
# false = run `python -m app.worker` separately (recommended). true = run jobs inside the API process.
NEWSWIRE_EMBEDDED_SCHEDULER=false
NEWSWIRE_SCHEDULER_TICK_SECONDS=30

# --- Images ----------------------------------------------------------------------------------
NEWSWIRE_MAX_IMAGE_BYTES=15000000
NEWSWIRE_MAX_UPLOAD_BYTES=15000000
# Uploaded videos (MP4/MOV) for the website, YouTube and Facebook Reels. Default 1 GB.
NEWSWIRE_MAX_VIDEO_BYTES=1000000000
# Optional free Openverse API credentials (higher rate limits). Register at api.openverse.org.
NEWSWIRE_OPENVERSE_CLIENT_ID=
NEWSWIRE_OPENVERSE_CLIENT_SECRET=

# --- Backups ---------------------------------------------------------------------------------
# Optional: encrypt backup archives (Fernet). Keep this key somewhere other than the server.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEWSWIRE_BACKUP_ENCRYPTION_KEY=
NEWSWIRE_PG_DUMP_PATH=pg_dump
NEWSWIRE_PG_RESTORE_PATH=pg_restore

# --- Logging and limits ----------------------------------------------------------------------
NEWSWIRE_LOG_LEVEL=INFO
NEWSWIRE_LOG_JSON=true
NEWSWIRE_RATE_LIMIT_PER_MINUTE=600
NEWSWIRE_LOGIN_RATE_LIMIT_PER_MINUTE=10
